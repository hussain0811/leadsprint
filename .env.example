# Copy to .env and fill in. .env is git-ignored.

# SQLite file for the local build (resolved from the project root).
DATABASE_URL="file:./data/dev.db"

# Encrypts saved connection secrets (AI keys etc.). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""

# Local-folder storage for uploaded documents (dev only).
STORAGE_DIR="./storage"

# Local build only: allow AI endpoints on localhost or private networks (LM Studio, Ollama).
ALLOW_PRIVATE_ENDPOINTS="true"
